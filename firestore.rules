rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "kurtislam100@gmail.com",
          "xtshh524@gmail.com",
          "namwingso@gmail.com"
        ];
    }

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('.*@gtcollege[.]edu[.]hk');
    }

    function isValidString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    match /adminCheck/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pageviews/{pageviewId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['path', 'durationSeconds', 'dateStr', 'timestamp', 'openedAt', 'lastActiveAt']
        )
        && isValidString(request.resource.data.path, 200)
        && request.resource.data.path.matches('^/[A-Za-z0-9_./-]*$')
        && request.resource.data.durationSeconds == 0
        && isValidString(request.resource.data.dateStr, 10)
        && request.resource.data.timestamp == request.time
        && request.resource.data.openedAt == request.time
        && request.resource.data.lastActiveAt == request.time
      );
      allow update: if isAdmin() || (
        request.resource.data.path == resource.data.path
        && request.resource.data.dateStr == resource.data.dateStr
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.openedAt == resource.data.openedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['durationSeconds', 'lastActiveAt', 'closedAt', 'userEmail', 'userName']
        )
        && request.resource.data.durationSeconds is number
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.durationSeconds <= 86400
        && request.resource.data.lastActiveAt is timestamp
        && (!('closedAt' in request.resource.data) || request.resource.data.closedAt is timestamp)
        && (!('userEmail' in request.resource.data) || (
          request.auth != null && request.resource.data.userEmail == request.auth.token.email
        ))
        && (!('userName' in request.resource.data) || isValidString(request.resource.data.userName, 200))
      );
    }

    match /feedbacks/{feedbackId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /publicFeedbacks/{feedbackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /supporters/{id} {
      allow read, delete: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
        && isValidString(request.resource.data.note, 200);
    }

    match /galleryFolders/{id} {
      allow read: if isSchoolUser() || isAdmin();
      allow write: if isAdmin();
    }

    match /galleryImages/{id} {
      allow read: if isSchoolUser() || isAdmin();
      allow write: if isAdmin();
    }

    // Published news is visible only to verified school Google accounts.
    match /news/{newsId} {
      allow get, list: if isAdmin() || (
        isSchoolUser()
        && resource.data.status == 'published'
        && resource.data.deleted == false
      );
      allow create, update, delete: if isAdmin();

      match /logs/{logId} {
        allow read, write: if isAdmin();
      }
    }

    // Drafts are private to the admin team and never appear in public news queries.
    match /newsDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Each school account can read and update only its own per-article receipt.
    match /newsReads/{receiptId} {
      allow read: if isAdmin() || (isSchoolUser() && resource.data.uid == request.auth.uid);
      allow create, update: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['uid', 'newsId', 'revision', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.newsId is string
        && request.resource.data.revision is int
        && request.resource.data.readAt == request.time
        && exists(/databases/$(database)/documents/news/$(request.resource.data.newsId))
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.status == 'published'
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.deleted == false
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.revision == request.resource.data.revision;
      allow delete: if isAdmin() || (isSchoolUser() && resource.data.uid == request.auth.uid);
    }
  }
}
