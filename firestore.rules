rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "kurtislam100@gmail.com",
          "xtshh524@gmail.com",
          "namwingso@gmail.com"
        ];
    }

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('^[^@]+@gtcollege[.]edu[.]hk$');
    }

    function isValidString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    match /adminCheck/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pageviews/{pageviewId} {
      allow read, write, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /publicFeedbacks/{feedbackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /supporters/{id} {
      allow read, delete: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
        && isValidString(request.resource.data.note, 200);
    }


    match /supporterIpCooldowns/{id} {
      allow read, write: if false;
    }

    match /galleryFolders/{id} {
      allow read: if isSchoolUser() || isAdmin();
      allow write: if isAdmin();
    }

    match /galleryImages/{id} {
      allow read: if isSchoolUser() || isAdmin();
      allow write: if isAdmin();
    }

    // Published announcements are public; read receipts remain account-private.
    match /news/{newsId} {
      allow get, list: if isAdmin() || (
        resource.data.status == 'published'
        && resource.data.deleted == false
      );
      allow create, update, delete: if isAdmin();

      match /logs/{logId} {
        allow read, write: if isAdmin();
      }
    }

    // Drafts are private to the admin team and never appear in public news queries.
    match /newsDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Each school account can read and update only its own per-article receipt.
    match /newsReads/{receiptId} {
      allow read: if isAdmin() || (isSchoolUser() && resource.data.uid == request.auth.uid);
      allow create: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['uid', 'newsId', 'revision', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.newsId is string
        && request.resource.data.revision is int
        && request.resource.data.readAt == request.time
        && exists(/databases/$(database)/documents/news/$(request.resource.data.newsId))
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.status == 'published'
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.deleted == false
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.revision == request.resource.data.revision;
      allow update: if isSchoolUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'newsId', 'revision', 'readAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.newsId is string
        && request.resource.data.revision is int
        && request.resource.data.readAt == request.time
        && exists(/databases/$(database)/documents/news/$(request.resource.data.newsId))
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.status == 'published'
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.deleted == false
        && get(/databases/$(database)/documents/news/$(request.resource.data.newsId)).data.revision == request.resource.data.revision;
      allow delete: if isAdmin() || (isSchoolUser() && resource.data.uid == request.auth.uid);
    }

    // Subscription addresses are private and can only be created by their
    // verified school account. Unsubscribes are handled by the signed email link.
    match /newsSubscriptions/{uid} {
      allow read: if isAdmin() || (isSchoolUser() && request.auth.uid == uid);
      allow create: if isSchoolUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'language', 'subscribed', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.language in ['en', 'zh']
        && request.resource.data.subscribed == true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
