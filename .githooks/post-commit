#!/bin/sh
# Reads #major / #minor at the end of the commit message (no tag = patch),
# bumps APP_VERSION and folds the change into the commit that was just made.
[ -n "$AURORA_VERSION_AMEND" ] && exit 0
for p in rebase-merge rebase-apply; do
  [ -e "$(git rev-parse --git-path $p)" ] && exit 0
done
git rev-parse -q --verify HEAD^2 >/dev/null && exit 0

node scripts/version.js commit || exit 0
if ! git diff --quiet -- public/js/info.js README.md README.zh-HK.md; then
  for f in public/js/info.js README.md README.zh-HK.md; do
    [ -e "$f" ] && git add "$f"
  done
  AURORA_VERSION_AMEND=1 git commit --amend --no-edit --no-verify -q
fi
exit 0
